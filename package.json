{
    "name": "sparxstar-3iatlas-dictionary",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "webpack",
        "dev": "webpack --watch",
        "watch": "webpack --watch",
        "lint": "pnpm run lint:js && pnpm run lint:css",
        "lint:js": "eslint \"src/**/*.js\" --fix",
        "lint:css": "stylelint \"src/**/*.css\" --fix",
        "docs:js": "jsdoc -c jsdoc.json",
        "format": "prettier --write .",
        "test": "jest --passWithNoTests",
        "prepare": "husky"
    },
    "version": "2.8.9",
    "description": "SPARXSTAR 3iAtlas Dictionary - A WordPress plugin for dictionary management with SCF and WPGraphQL integration.",
    "main": "commitlint.config.js",
    "directories": {
        "doc": "docs",
        "example": "examples",
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Starisian-Technologies/sparxstar-3iatlas-dictionary.git"
    },
    "keywords": [],
    "author": "Starisian Technologies <support@starisian.com>",
    "license": "proprietary",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/Starisian-Technologies/sparxstar-3iatlas-dictionary/issues"
    },
    "homepage": "https://github.com/Starisian-Technologies/sparxstar-3iatlas-dictionary#readme",
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "graphql": "^16.14.2",
        "jsdoc-babel": "^0.5.0",
        "lucide-react": "^0.300.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-virtuoso": "^4.18.7"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@eslint/js": "^8.57.1",
        "autoprefixer": "^10.5.0",
        "babel-loader": "^10.1.1",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^5.0.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "globals": "^13.24.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jsdoc": "^4.0.5",
        "lint-staged": "^17.0.7",
        "mini-css-extract-plugin": "^2.10.2",
        "postcss": "^8.5.15",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.8.4",
        "stylelint": "^17.13.0",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^3.4.19",
        "terser-webpack-plugin": "^5.6.1",
        "webpack": "^5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.php": [
            "phpcs -q",
            "composer run analyze:php"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "webpack-dev-server": "^5.2.1",
        "minimatch": "^9.0.7",
        "@babel/plugin-transform-modules-systemjs": "^7.29.4",
        "serialize-javascript": "^7.0.5",
        "js-yaml": "^4.1.1"
    }
}