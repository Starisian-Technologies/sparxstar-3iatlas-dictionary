includes:
  - phpstan-baseline.neon

parameters:
  level: 5
  phpVersion: 80200

  paths:
    - ./src

  bootstrapFiles:
    - ./vendor/autoload.php
    - ./tests/phpstan/bootstrap.php

  stubFiles:
    - ./vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php

  treatPhpDocTypesAsCertain: false

  scanFiles:
    - sparxstar-3iatlas-dictionary.php

  excludePaths:
    - tests/*
    - vendor/*
    - node_modules/*
    - assets/*

  # WP-CLI is an optional CLI-only dependency; no stubs are installed for it.
  # Suppress only in files that legitimately use WP_CLI.
  # Globbed rather than pinned per file: pinning is exactly why v3.0.0 failed.
  # A new command file, Sparxstar3IAtlasSystemCredentialCliCommands.php, was not
  # in the list and produced nine errors that stopped the release.
  ignoreErrors:
    - message: '#^Call to static method .+ on an unknown class WP_CLI\.$#'
      paths:
        - src/cli/*
        - src/core/Sparxstar3IAtlasDictionary.php
    - message: '#^Function WP_CLI.+ not found\.$#'
      paths:
        - src/cli/*
    - message: '#^Call to static method .+ on an unknown class WP_CLI\.$#'
      path: src/core/Sparxstar3IAtlasDictionary.php
    - message: '#^Function WP_CLI.+ not found\.$#'
      path: src/cli/Sparxstar3IAtlasDictionaryCliCommands.php

  # Pre-existing findings are captured in phpstan-baseline.neon (baseline-first).
  # New code must pass clean at this level; clear baseline entries as files are fixed.
  reportUnmatchedIgnoredErrors: false

