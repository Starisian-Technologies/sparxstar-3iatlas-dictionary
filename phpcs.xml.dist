<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="Starisian WordPress Plugin"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

  <description>
    Repo-wide PHPCS gate for the SPARXSTAR 3iAtlas Dictionary. Canonical standard is
    WordPress Coding Standards + VIPWPCS (see .phpcs-strict.xml.dist). This gate runs the
    same standard but demotes pre-existing legacy violations to warnings and does not fail
    the build on warnings — a transitional baseline so CI is green now while the debt is
    cleaned up incrementally. New/modified files are held to the full standard via the
    `lint:php:strict` script (.phpcs-strict.xml.dist) on changed files in CI.
  </description>

  <!-- Scan the plugin source and bootstrap. -->
  <file>src</file>
  <file>sparxstar-3iatlas-dictionary.php</file>

  <!-- Exclude generated, vendored, and non-plugin paths. -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>assets/*</exclude-pattern>
  <exclude-pattern>tests/*</exclude-pattern>
  <exclude-pattern>dest_test/*</exclude-pattern>
  <exclude-pattern>*/index.php</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="parallel" value="8"/>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Warnings are tracked, not blocking: the legacy baseline is reported but does not
       fail CI. Remove demotions below (and this flag) as files are brought up to standard. -->
  <config name="ignore_warnings_on_exit" value="1"/>

  <!-- ============================================================= -->
  <!-- Canonical standard: WordPress Coding Standards + VIPWPCS.       -->
  <!-- ============================================================= -->
  <rule ref="WordPress-Extra">
    <!-- This plugin uses space indentation (see .editorconfig), not WP tabs. -->
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
  </rule>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-VIP-Go"/>
  <rule ref="Generic.Commenting.Todo"/>

  <!-- PSR-4 PascalCase class files: WordPress class-file-name convention does not apply. -->
  <rule ref="WordPress.Files.FileName">
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
  </rule>

  <!-- Short ternary (?:) is permitted on PHP 8.2+; intentional project choice. -->
  <rule ref="Universal.Operators.DisallowShortTernary">
    <severity>0</severity>
  </rule>

  <!-- Enforce spaces, not tabs (4-space indent). -->
  <arg name="tab-width" value="4"/>
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="4"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

  <config name="minimum_wp_version" value="6.8"/>

  <!-- Correct text domain (matches AGENTS.md). -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="sparxstar-3iatlas-dictionary"/>
      </property>
    </properties>
  </rule>

  <!-- Real global prefixes used by this plugin (functions, hooks, constants, namespace). -->
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="Starisian\Sparxstar\IAtlas"/>
        <element value="sparxstar"/>
        <element value="sparx"/>
        <element value="aiwa"/>
        <element value="starisian"/>
      </property>
    </properties>
  </rule>

  <!-- PHP 8.2+ compatibility. -->
  <config name="testVersion" value="8.2-"/>
  <rule ref="PHPCompatibility"/>

  <!-- ============================================================= -->
  <!-- Transitional baseline: demote pre-existing legacy violations   -->
  <!-- to warnings. Re-promote (delete the line) once a category is   -->
  <!-- cleaned up. Priority to re-promote first: the Security group.   -->
  <!-- ============================================================= -->

  <!-- Documentation / comment-style debt (missing or incomplete docblocks, comment punctuation). -->
  <rule ref="Squiz.Commenting.FileComment"><type>warning</type></rule>
  <rule ref="Squiz.Commenting.ClassComment"><type>warning</type></rule>
  <rule ref="Squiz.Commenting.FunctionComment"><type>warning</type></rule>
  <rule ref="Squiz.Commenting.FunctionCommentThrowTag"><type>warning</type></rule>
  <rule ref="Squiz.Commenting.VariableComment"><type>warning</type></rule>
  <rule ref="Squiz.Commenting.InlineComment"><type>warning</type></rule>
  <rule ref="Generic.Commenting.DocComment"><type>warning</type></rule>
  <rule ref="PSR12.Files.FileHeader"><type>warning</type></rule>

  <!-- Naming / structure debt. -->
  <rule ref="PSR2.Methods.MethodDeclaration"><type>warning</type></rule>
  <rule ref="WordPress.NamingConventions.ValidFunctionName"><type>warning</type></rule>
  <rule ref="WordPress.NamingConventions.ValidVariableName"><type>warning</type></rule>
  <rule ref="WordPress.PHP.YodaConditions"><type>warning</type></rule>
  <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"><type>warning</type></rule>

  <!-- Debug logging and VIP-platform restrictions that are intentional here (activation
       rewrite flush, request-header reads for auth/rate-limiting, error_log diagnostics). -->
  <rule ref="WordPress.PHP.DevelopmentFunctions"><type>warning</type></rule>
  <rule ref="WordPress.PHP.DevelopmentFunctions.error_log_error_log"><type>warning</type></rule>
  <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions"><type>warning</type></rule>
  <rule ref="WordPressVIPMinimum.Variables.ServerVariables"><type>warning</type></rule>

  <!-- Security / DB debt — RE-PROMOTE AND FIX THESE FIRST when tightening. -->
  <rule ref="WordPress.Security.EscapeOutput"><type>warning</type></rule>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"><type>warning</type></rule>
  <rule ref="WordPress.DB.PreparedSQL"><type>warning</type></rule>
  <rule ref="WordPress.DB.DirectDatabaseQuery"><type>warning</type></rule>

</ruleset>
