<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         name="Starisian WordPress Plugin"
         xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd">

  <description>
    WordPress coding standards for Starisian Technologies plugins. Includes support for Docs, I18n, and performance best practices.
  </description>

  <!-- Scan all files in the plugin root -->
  <file>.</file>

  <!-- Exclude unnecessary paths -->
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
  <exclude-pattern>tests/*</exclude-pattern>
  <exclude-pattern>wp-assets/*</exclude-pattern>

  <!-- Basepath -->
  <arg name="basepath" value="."/>

  <!-- Parallel processing -->
  <arg name="parallel" value="8"/>

  <!-- Only scan PHP files -->
  <arg name="extensions" value="php"/>

  <!--
    Suppress warnings from CI exit code.
    Warnings are informational (TODO markers, VIP-specific advisories, slow-query hints)
    and are tracked separately; they do not block merge.
  -->
  <arg name="warning-severity" value="0"/>

  <!-- Coding standard rules -->
  <rule ref="WordPress-Extra">
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
  </rule>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-VIP-Go"/>
  <rule ref="Generic.Commenting.Todo"/>

  <!-- Enforce spaces, not tabs -->
  <arg name="tab-width" value="4"/>
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="4"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

  <!-- Minimum WordPress version for compatibility checks -->
  <config name="minimum_wp_version" value="6.8"/>

  <!-- Text domain: matches Text Domain header and all __() calls in the plugin -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="sparxstar-3iatlas-dictionary"/>
      </property>
    </properties>
  </rule>

  <!-- Global prefix enforcement: all prefixes used in this codebase -->
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="starisian"/>
        <element value="sparxstar"/>
        <element value="SPARXSTAR"/>
        <element value="sparx"/>
        <element value="SPARX"/>
        <element value="aiwa"/>
        <element value="AIWA"/>
      </property>
    </properties>
  </rule>

  <!--
    PSR-4 class files use PascalCase filenames (Sparxstar3IAtlas*.php).
    WordPress.Files.FileName expects lowercase-hyphen.
    The codebase deliberately uses PSR-4 for autoloading; exclude class files from this sniff.
  -->
  <rule ref="WordPress.Files.FileName">
    <exclude-pattern>src/*/*.php</exclude-pattern>
    <exclude-pattern>src/*.php</exclude-pattern>
    <exclude-pattern>tests/*Test.php</exclude-pattern>
  </rule>

  <!--
    PSR-4 class methods follow the sparxIAtlas_* camelCase+underscore convention.
    Renaming would break all registered WordPress hooks. Exclude from snake_case enforcement.
  -->
  <rule ref="WordPress.NamingConventions.ValidFunctionName">
    <exclude-pattern>src/*/*.php</exclude-pattern>
    <exclude-pattern>src/*.php</exclude-pattern>
    <exclude-pattern>sparxstar-3iatlas-dictionary.php</exclude-pattern>
  </rule>

  <!--
    flush_rewrite_rules() is used correctly in plugin activation/deactivation hooks.
    The WordPress VIP minimum sniff flags it globally but it is correct usage here.
  -->
  <rule ref="WordPressVIPMinimum.Functions.RestrictedFunctions">
    <exclude name="WordPressVIPMinimum.Functions.RestrictedFunctions.flush_rewrite_rules_flush_rewrite_rules"/>
  </rule>

  <!-- Exclude certain sniffs in test files -->
  <rule ref="WordPress.WP.GlobalVariablesOverride">
    <exclude-pattern>tests/*Test.php</exclude-pattern>
  </rule>

  <!-- PHPCompatibility checks -->
  <config name="testVersion" value="8.2-"/>
  <rule ref="PHPCompatibility"/>

</ruleset>
