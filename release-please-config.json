{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sparxstar-3iatlas-dictionary",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "sparxstar-3iatlas-dictionary.php",
          "expressions": [
            "Version:\\s*([0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)",
            "define\\(\\s*'SPARX_3IATLAS_VERSION',\\s*'([0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)'\\s*\\);"
          ]
        }
      ]
    }
  }
}
