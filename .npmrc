# pnpm configuration.
# Use a flat, hoisted node_modules (npm-like) to avoid symlink issues with tooling,
# while still getting pnpm's strict, content-addressed lockfile + --frozen-lockfile CI.
node-linker=hoisted
# Fail fast in CI if the lockfile is out of sync (this is the drift guard).
# (CI passes --frozen-lockfile explicitly; this documents intent for local runs.)
auto-install-peers=true
